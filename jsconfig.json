{
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2022",
		"checkJs": true,
		"noEmit": true,
		"allowJs": true,
		"strict": false,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["node"]
	},
	"include": ["cli/**/*.js", "packages/**/*.js"],
	"exclude": ["node_modules", "packages/server/src/tools/vendor"]
}
